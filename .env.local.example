NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pre-launch password gate (middleware.ts + app/preview-access/). Deliberately
# NOT prefixed with NEXT_PUBLIC_ — it's read only on the server/middleware and
# must never reach the client bundle. Leave unset to keep the app fully gated.
PREVIEW_PASSWORD=

# Service-role key (Supabase project settings -> API) — server-only, bypasses
# RLS. Used solely by the Card of the Week cron route.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# invokes /api/cron/* routes. Set the same value in the Vercel project's
# environment variables — Vercel adds the header automatically once this var
# exists there, no extra config needed.
CRON_SECRET=
